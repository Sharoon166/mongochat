# mongochat configuration
# Copy to .env and fill in. Precedence: CLI flag > environment variable > .env > default.

# MongoDB (read-only user recommended)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sample_mflix

# LLM provider (OpenAI-compatible; BYOK works with OpenRouter, Ollama, LM Studio, ...)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# Optional: guard /v1 and /api with "Authorization: Bearer <token>"
# MONGOCHAT_API_TOKEN=change-me

# MONGOCHAT_DEBUG=false
# MONGOCHAT_MAX_STEPS=8
